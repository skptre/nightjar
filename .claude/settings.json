{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8"
  },
  "permissions": {
    "allow": [
      "Bash(uv*)",
      "Bash(python*)",
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(make*)",
      "Bash(git*)",
      "Bash(gh*)",
      "Bash(npm*)",
      "Bash(npx*)",
      "Bash(cargo*)",
      "Bash(jq*)",
      "Edit(poller/**)",
      "Edit(app/**)",
      "Edit(extension/**)",
      "Edit(companies.yaml)",
      "Edit(Makefile)",
      "Edit(.github/workflows/**)",
      "Read(**)",
      "Write(poller/**)",
      "Write(app/**)",
      "Write(data/**)",
      "Write(.github/workflows/**)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo rm*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Edit(data/feed.json)",
      "Edit(data/state.json)",
      "WebFetch(domain:linkedin.com)",
      "WebFetch(domain:www.linkedin.com)",
      "WebFetch(domain:indeed.com)",
      "WebFetch(domain:www.indeed.com)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "ecc@ecc": true,
    "claude-mem@thedotmack": true,
    "superpowers@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "outputStyle": "Explanatory",
  "effortLevel": "high",
  "plansDirectory": ".claude/plans"
}
