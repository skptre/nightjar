{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nightjar",
  "version": "0.1.0",
  "identifier": "com.nightjar.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nightjar",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://skptre.github.io https://raw.githubusercontent.com https://boards-api.greenhouse.io https://api.lever.co https://api.eu.lever.co https://api.ashbyhq.com https://api.smartrecruiters.com https://*.myworkdayjobs.com https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com; img-src 'self' data:"
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:nightjar.db"
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/skptre/nightjar/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBNTZFMTY0NjQ5MzBFNQpSV1RsTUVsR0ZtNmxCWlRhQkptQW9wZlZpa09PUzlTTlJ4bExQQmluME1jL3l4Tm0rQXZyQnVaUAo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
}
