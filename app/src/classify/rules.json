  "sponsorship_patterns": [
    { "pattern": "must be a u\\.?s\\.? citizen", "flag_type": "citizenship_required" },
    { "pattern": "must be a united states citizen", "flag_type": "citizenship_required" },
    { "pattern": "u\\.?s\\.? citizenship(?:\\s+is)?\\s+required", "flag_type": "citizenship_required" },
    { "pattern": "united states citizenship(?:\\s+is)?\\s+required", "flag_type": "citizenship_required" },
    { "pattern": "requires? u\\.?s\\.? citizenship", "flag_type": "citizenship_required" },
    { "pattern": "only u\\.?s\\.? citizens", "flag_type": "citizenship_required" },
    { "pattern": "citizen of the united states", "flag_type": "citizenship_required" },
    { "pattern": "must be a u\\.?s\\.? person", "flag_type": "citizenship_required" },
    { "pattern": "u\\.?s\\.? person(?:s)? as defined", "flag_type": "citizenship_required" },

    { "pattern": "permanent resident(?:s)? (?:of the u|only|required)", "flag_type": "citizenship_required" },
    { "pattern": "green card(?:\\s+holder)?(?:\\s+required)?", "flag_type": "citizenship_required" },
    { "pattern": "lawful permanent resident", "flag_type": "citizenship_required" },

    { "pattern": "security clearance(?:\\s+(?:is\\s+)?required)?", "flag_type": "clearance_required" },
    { "pattern": "active\\s+(?:security\\s+)?clearance", "flag_type": "clearance_required" },
    { "pattern": "must (?:hold|have|possess|obtain|maintain)\\s+(?:a\\s+)?(?:active\\s+)?(?:security\\s+)?clearance", "flag_type": "clearance_required" },
    { "pattern": "ts\\/sci", "flag_type": "clearance_required" },
    { "pattern": "top secret", "flag_type": "clearance_required" },
    { "pattern": "secret clearance", "flag_type": "clearance_required" },
    { "pattern": "public trust", "flag_type": "clearance_required" },
    { "pattern": "eligib(?:le|ility) (?:for|to obtain) (?:a )?(?:security )?clearance", "flag_type": "clearance_required" },

    { "pattern": "(?:subject to|governed by|compliance with|regulated under)\\s+itar", "flag_type": "itar_ear" },
    { "pattern": "itar(?:\\s+(?:and|or|/)\\s+ear)?\\s+(?:regulat|restrict|requir|compli)", "flag_type": "itar_ear" },
    { "pattern": "international traffic in arms regulations", "flag_type": "itar_ear" },
    { "pattern": "export(?:\\s+control)?\\s+(?:regulat|restrict|requir|compli)", "flag_type": "itar_ear" },
    { "pattern": "ear(?:\\s+(?:and|or|/)\\s+itar)?\\s+(?:regulat|restrict|requir)", "flag_type": "itar_ear" },
    { "pattern": "export administration regulations", "flag_type": "itar_ear" },

    { "pattern": "(?:unable|not able)\\s+to\\s+(?:provide\\s+)?sponsor", "flag_type": "no_sponsorship" },
    { "pattern": "(?:cannot|can not|can't)\\s+sponsor", "flag_type": "no_sponsorship" },
    { "pattern": "(?:will|does|do)\\s+not\\s+(?:provide\\s+)?sponsor", "flag_type": "no_sponsorship" },
    { "pattern": "(?:will|does|do)n't\\s+(?:provide\\s+)?sponsor", "flag_type": "no_sponsorship" },
    { "pattern": "no\\s+(?:visa\\s+)?sponsorship", "flag_type": "no_sponsorship" },
    { "pattern": "not\\s+(?:offer(?:ing)?|provid(?:e|ing))\\s+(?:(?:visa|immigration|employment|work)\\s+)?sponsorship", "flag_type": "no_sponsorship" },
    { "pattern": "without\\s+(?:the\\s+need\\s+for\\s+)?(?:visa\\s+)?sponsorship", "flag_type": "no_sponsorship" },
    { "pattern": "must not require\\s+(?:visa\\s+)?sponsorship", "flag_type": "no_sponsorship" },
    { "pattern": "(?:not|in)eligible for\\s+(?:visa\\s+)?sponsorship", "flag_type": "no_sponsorship" },
    { "pattern": "no\\s+(?:work\\s+)?visa\\s+sponsorship", "flag_type": "no_sponsorship" },
    { "pattern": "(?:must\\s+(?:be|have)\\s+)?(?:legally\\s+)?authorized\\s+to\\s+work\\s+in\\s+the\\s+(?:united\\s+states|u\\.?s\\.?)\\s+without\\s+(?:need(?:ing)?\\s+(?:for\\s+)?)?sponsorship", "flag_type": "no_sponsorship" },
    { "pattern": "must\\s+(?:have|possess)\\s+unrestricted\\s+(?:work\\s+)?authorization", "flag_type": "no_sponsorship" },
    { "pattern": "unrestricted\\s+(?:right|authorization|eligibility)\\s+to\\s+work", "flag_type": "no_sponsorship" },
    { "pattern": "(?:employment|work)\\s+(?:eligibility|authorization)\\s+(?:verification\\s+)?required\\s+without\\s+sponsorship", "flag_type": "no_sponsorship" },
    { "pattern": "this\\s+(?:position|role)\\s+(?:is\\s+)?not\\s+(?:eligible|open)\\s+(?:for|to)\\s+(?:visa\\s+)?sponsorship", "flag_type": "no_sponsorship" },
    { "pattern": "visa\\s+(?:transfer|sponsorship)\\s+(?:is\\s+)?not\\s+(?:available|offered|provided)", "flag_type": "no_sponsorship" }
  ],
  "grad_window_patterns": [
    "(?:graduating|graduation(?:\\s+date)?)\\s+(?:in\\s+|by\\s+|between\\s+)?(?:(?:january|february|march|april|may|june|july|august|september|october|november|december|jan|feb|mar|apr|jun|jul|aug|sep|sept|oct|nov|dec|spring|summer|fall|winter)\\s+)?(20\\d{2})",
    "class\\s+of\\s+(20\\d{2})",
    "(?:expected|anticipated)\\s+graduation[:\\s]+(?:(?:january|february|march|april|may|june|july|august|september|october|november|december|jan|feb|mar|apr|jun|jul|aug|sep|sept|oct|nov|dec|spring|summer|fall|winter)\\s+)?(20\\d{2})",
    "must\\s+(?:be\\s+)?graduat(?:e|ing)\\s+(?:by|before|no\\s+later\\s+than)\\s+(?:(?:january|february|march|april|may|june|july|august|september|october|november|december|jan|feb|mar|apr|jun|jul|aug|sep|sept|oct|nov|dec|spring|summer|fall|winter)\\s+)?(20\\d{2})",
    "(?:graduation|degree\\s+completion)\\s+(?:date\\s+)?between\\s+(?:\\w+\\s+)?(20\\d{2})\\s+(?:and|-)\\s+(?:\\w+\\s+)?(20\\d{2})",
    "pursuing\\s+(?:a\\s+)?(?:bachelor|master|phd|undergraduate|graduate)(?:'s)?\\s+degree\\s+(?:with\\s+)?(?:expected|anticipated)?\\s*(?:graduation|completion)?\\s*(?:in\\s+|by\\s+)?(?:(?:january|february|march|april|may|june|july|august|september|october|november|december|spring|summer|fall|winter)\\s+)?(20\\d{2})"
  ],
  "class_year_patterns": [
    { "pattern": "(?:rising|current(?:ly)?)?\\s*senior(?:s)?\\s+only", "class_year": "senior" },
    { "pattern": "(?:rising|current(?:ly)?)?\\s*junior(?:s)?\\s+only", "class_year": "junior" },
    { "pattern": "(?:rising|current(?:ly)?)?\\s*sophomore(?:s)?\\s+only", "class_year": "sophomore" },
    { "pattern": "(?:rising|current(?:ly)?)?\\s*freshman\\s+only", "class_year": "freshman" },
    { "pattern": "(?:rising|current(?:ly)?)?\\s*freshmen\\s+only", "class_year": "freshman" },
    { "pattern": "phd\\s+(?:required|only|student(?:s)?\\s+only|candidate(?:s)?\\s+only)", "class_year": "phd" },
    { "pattern": "must\\s+be\\s+(?:a\\s+)?(?:current\\s+)?phd\\s+(?:student|candidate)", "class_year": "phd" },
    { "pattern": "(?:master'?s?|mba)\\s+(?:required|only|student(?:s)?\\s+only)", "class_year": "masters" },
    { "pattern": "must\\s+be\\s+(?:a\\s+)?(?:current\\s+)?(?:master'?s?|mba)\\s+student", "class_year": "masters" },
    { "pattern": "(?:first|1st)[\\s-]year\\s+(?:student(?:s)?\\s+)?only", "class_year": "freshman" },
    { "pattern": "(?:second|2nd)[\\s-]year\\s+(?:student(?:s)?\\s+)?only", "class_year": "sophomore" },
    { "pattern": "(?:third|3rd)[\\s-]year\\s+(?:student(?:s)?\\s+)?only", "class_year": "junior" },
    { "pattern": "(?:fourth|4th)[\\s-]year\\s+(?:student(?:s)?\\s+)?only", "class_year": "senior" }
  ]
